# Configuración de base de datos Supabase
SUPABASE_URL="https://tu-id-de-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-publica"

# Credenciales separadas según el entorno
# El equipo de hardware/simulador solo usa la cuenta Operador
OPERADOR_EMAIL="operador@empresagg.com"
OPERADOR_PASSWORD="password_operador"

# El equipo de control solo usa la cuenta Supervisor
SUPERVISOR_EMAIL="supervisor@empresagg.com"
SUPERVISOR_PASSWORD="password_supervisor"